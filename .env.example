# Enable Banking - register an app at https://enablebanking.com to get these
APP_ID=YOUR_ENABLE_BANKING_APP_ID
PEM_FILE=YOUR_ENABLE_BANKING_APP_ID.pem

# Optional PocketSmith synchronization used by `persfin-cli --pocketsmith`.
# Create a developer key under PocketSmith Settings > Security.
# POCKETSMITH_DEVELOPER_KEY=YOUR_POCKETSMITH_DEVELOPER_KEY
# Optional: transactions before this date are never uploaded. Set this to avoid
# duplicating transactions previously imported manually or from CSV. Without it,
# synchronization uses --from-date or defaults to the last 90 days.
# POCKETSMITH_CUTOVER_DATE=YYYY-MM-DD
